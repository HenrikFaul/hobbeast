{
  "manifest_version": 3,
  "name": "Hobbeast eseményimportáló",
  "version": "1.1.0",
  "description": "Egy megnyitott Facebook-esemény vagy -bejegyzés adatait beolvassa, megmutatja ellenőrzésre, és beküldi a Hobbeast katalógusába.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*",
    "https://bqdvqmpwccsxumzijspj.supabase.co/*"
  ],
  "action": {
    "default_title": "Hobbeast importálás",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
