{
  "manifest_version": 3,
  "name": "Hobbeast eseményimportáló",
  "version": "2.0.0",
  "description": "Egy megnyitott Facebook-esemény vagy -bejegyzés adatait beolvassa, és átadja a Hobbeast admin felületének ellenőrzésre.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "action": {
    "default_title": "Hobbeast importálás",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
