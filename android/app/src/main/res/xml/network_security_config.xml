<?xml version="1.0" encoding="utf-8"?>
<!-- Forbids cleartext (HTTP) traffic globally and trusts only the system CA
     store. Capacitor serves the bundled web app over https://localhost, so no
     cleartext exception is required. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
