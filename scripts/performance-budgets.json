{
  "schemaVersion": 1,
  "distDirectory": "dist/assets",
  "budgets": [
    {
      "id": "landing-main-js",
      "pattern": "^index-[A-Za-z0-9_-]+\\.js$",
      "maxRawBytes": 163840,
      "maxGzipBytes": 51200,
      "required": true
    },
    {
      "id": "global-css",
      "pattern": "^index-[A-Za-z0-9_-]+\\.css$",
      "maxRawBytes": 135168,
      "maxGzipBytes": 22528,
      "required": true,
      "note": "Raw ceiling raised from 131072 in v1.26.0: the previous limit left 52 bytes of headroom, so any new component broke it. Gzip stays at 22528 and is the binding constraint — that is what crosses the network."
    },
    {
      "id": "events-route",
      "pattern": "^Events-[A-Za-z0-9_-]+\\.js$",
      "maxRawBytes": 122880,
      "maxGzipBytes": 40960,
      "required": true
    },
    {
      "id": "event-detail-route",
      "pattern": "^EventDetail-[A-Za-z0-9_-]+\\.js$",
      "maxRawBytes": 81920,
      "maxGzipBytes": 30720,
      "required": true
    },
    {
      "id": "admin-route",
      "pattern": "^Admin-[A-Za-z0-9_-]+\\.js$",
      "maxRawBytes": 51200,
      "maxGzipBytes": 20480,
      "required": true,
      "note": "Every admin panel is lazy-loaded per tab since v1.26.0, so this chunk is the shell only. It was 251 KB before the split, over even the old ceiling."
    },
    {
      "id": "organizer-route",
      "pattern": "^OrganizerDashboard-[A-Za-z0-9_-]+\\.js$",
      "maxRawBytes": 122880,
      "maxGzipBytes": 40960,
      "required": true
    },
    {
      "id": "individual-images",
      "pattern": "\\.(png|jpg|jpeg|webp|avif)$",
      "maxRawBytes": 256000,
      "maxGzipBytes": 256000,
      "required": true,
      "perFile": true
    },
    {
      "id": "individual-videos",
      "pattern": "\\.(mp4|webm)$",
      "maxRawBytes": 1500000,
      "maxGzipBytes": 1500000,
      "required": true,
      "perFile": true
    },
    {
      "id": "hero-video-variants-total",
      "pattern": "^hero-together-(day|night)-[A-Za-z0-9_-]+\\.mp4$",
      "maxRawBytes": 2500000,
      "maxGzipBytes": 2500000,
      "required": true,
      "minMatches": 2,
      "maxMatches": 2
    },
    {
      "id": "individual-js-ceiling",
      "pattern": "\\.js$",
      "maxRawBytes": 921600,
      "maxGzipBytes": 307200,
      "required": true,
      "perFile": true
    }
  ]
}
